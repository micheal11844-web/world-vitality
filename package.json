{
  "name": "world-vitality",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --build --dry",
    "build": "tsc --build",
    "test": "tsc --build && node --test --test-reporter spec $(find . -path '*/node_modules' -prune -o -path '*/dist/*' -name '*.test.js' -print)"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.3.0"
  }
}
