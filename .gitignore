# Dependencies
node_modules/

# Build output
dist/
build/
.turbo/
.next/
*.tsbuildinfo

# CesiumJS runtime assets (BUILD_PLAN "STAGE — GOD'S EYE GLOBE VIEW") —
# copied verbatim from node_modules/cesium at dev/build time by
# apps/web/scripts/copy-cesium-assets.mjs (predev/prebuild), never
# committed — same reasoning as dist/ above: a reproducible copy of
# something pnpm install already gives us.
apps/web/public/cesium/

# MapLibre's background-worker file (MapLibre 6 needs it served from the
# site) — copied from node_modules/maplibre-gl by
# apps/web/scripts/copy-maplibre-worker.mjs (predev/prebuild), never committed.
apps/web/public/maplibre/

# Env / secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Vercel
.vercel/
