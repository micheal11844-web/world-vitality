# Supabase project settings (Stage 3 — identity-service).
# Copy to .env.local (or set directly in Vercel Project Settings → Environment
# Variables). Never commit actual values — .env* is already gitignored except
# this .example file.

# Project URL, from Supabase Dashboard → Project Settings → API.
SUPABASE_URL=

# Service role key — server-side only, NEVER exposed to the browser/client
# bundle. From Supabase Dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Anon/publishable key — added for Google OAuth (apps/web/lib/supabase-ssr.ts).
# Weaker privileges than the service role key, but still a distinct real
# credential — do not substitute the service role key here or vice versa.
# From Supabase Dashboard → Project Settings → API.
SUPABASE_ANON_KEY=

# Where the magic-link email redirects back to after the user clicks it.
# e.g. http://localhost:3000/auth/callback in development,
# https://<your-domain>/auth/callback in production.
#
# Also reused as the Google OAuth callback URL — the same route
# (apps/web/app/auth/callback/route.ts) handles both, branching on
# whether the request has a token_hash (magic link) or code (OAuth)
# param. Google sign-in additionally requires, in Supabase Dashboard →
# Authentication → Providers → Google: a real Google Cloud OAuth Client
# ID/Secret, with this exact URL added as an authorized redirect URI in
# the Google Cloud Console. This setup is real, manual, one-time work
# in both consoles that no code change can substitute for.
SUPABASE_AUTH_REDIRECT_URL=
