# Billing (BUILD_PLAN "v90"). All of this is OFF by default. Set these in
# Vercel Project Settings → Environment Variables — never commit values.
# See docs/runbooks/billing.md for the order to do things in.

# The master switch. Anything other than the exact text "true" leaves billing
# off: the webhook answers 404, nobody is limited, the database is not read.
BILLING_ENABLED=

# Paystack secret key (sk_test_… while testing, sk_live_… when charging for
# real). Server-side only. It is also what Paystack signs webhooks with.
# From Paystack Dashboard → Settings → API Keys & Webhooks. Add it yourself in
# Vercel — do not paste it into chat or into a file in the repo.
PAYSTACK_SECRET_KEY=

# Which Paystack plan is which. Create the plans in the Paystack Dashboard
# (a plan fixes the amount, currency and interval), then list their codes as
# JSON keyed "<plan>.<currency>.<interval>". Plan codes are identifiers, not
# secrets. Leave out any combination that is not for sale yet, e.g.
# {"standard.NGN.monthly":"PLN_xxxxxxxx","premium.NGN.monthly":"PLN_yyyyyyyy"}
PAYSTACK_PLAN_CODES=
